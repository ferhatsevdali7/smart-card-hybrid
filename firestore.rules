rules_version = '2';

// =====================================================================
//  Akıllı Araç Kartı - Firestore Güvenlik Kuralları (v2)
//
//  İlke: QR etiketlerini değiştiren her işlem Cloud Functions üzerinden
//  yapılır. İstemci etiketlere ASLA yazamaz. Ziyaretçi araç verisini
//  doğrudan okuyamaz; yalnızca scanTag fonksiyonunun döndürdüğü güvenli
//  alanları görür (telefon numarası hiçbir zaman gönderilmez).
// =====================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ------------------------------------------------------------ yardımcılar
    function signedIn() {
      return request.auth != null;
    }

    function myEmail() {
      return signedIn() && request.auth.token.email is string
        ? request.auth.token.email.lower()
        : '';
    }

    // functions/src/config.ts -> SUPER_ADMIN_EMAILS ile aynı olmalı
    function isSuperAdmin() {
      return myEmail() in ['sevdaliferhat64@gmail.com', 'hasimturcan199@gmail.com'];
    }

    function isStaff() {
      return isSuperAdmin() || (
        signedIn()
        && request.auth.token.email_verified == true
        && exists(/databases/$(database)/documents/staff_members/$(myEmail()))
        && get(/databases/$(database)/documents/staff_members/$(myEmail())).data.isActive != false
      );
    }

    function changedOnly(fields) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(fields);
    }

    // ------------------------------------------------------------ QR etiketleri
    // Okuma: yalnızca etiketin sahibi (kendi etiketi) ve yöneticiler.
    // Yazma: hiç kimse (yalnızca Cloud Functions).
    match /tags/{code} {
      allow get: if isStaff() || (signedIn() && resource.data.assignedUserId == request.auth.uid);
      allow list: if isStaff();
      allow write: if false;
    }

    // ------------------------------------------------------------ Araçlar
    function validVehicle(d) {
      return d.keys().hasOnly([
          'ownerUid', 'plateNumber', 'brandModel', 'ownerName', 'contactPhone',
          'parkingNote', 'allowMessages', 'tagCode', 'tagSerial',
          'unreadNotices', 'lastNoticeAt', 'createdAt', 'updatedAt'
        ])
        && d.plateNumber is string && d.plateNumber.size() >= 2 && d.plateNumber.size() <= 16
        && (!('brandModel' in d) || (d.brandModel is string && d.brandModel.size() <= 60))
        && (!('ownerName' in d) || (d.ownerName is string && d.ownerName.size() <= 60))
        && (!('contactPhone' in d) || (d.contactPhone is string && d.contactPhone.size() <= 20))
        && (!('parkingNote' in d) || (d.parkingNote is string && d.parkingNote.size() <= 200))
        && (!('allowMessages' in d) || d.allowMessages is bool);
    }

    match /vehicles/{vehicleId} {
      allow read: if signedIn() && resource.data.ownerUid == request.auth.uid;

      // Yeni araç: sahibi kendisi, etiket bağlı değil.
      allow create: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.get('tagCode', null) == null
        && request.resource.data.get('tagSerial', null) == null
        && request.resource.data.get('unreadNotices', 0) == 0
        && validVehicle(request.resource.data);

      // Güncelleme: sahiplik ve etiket alanları değiştirilemez (onlar sunucuda).
      allow update: if signedIn()
        && resource.data.ownerUid == request.auth.uid
        && validVehicle(request.resource.data)
        && !request.resource.data.diff(resource.data).affectedKeys()
              .hasAny(['ownerUid', 'tagCode', 'tagSerial', 'lastNoticeAt'])
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['unreadNotices'])
            || request.resource.data.unreadNotices == 0);

      // Silme: önce QR etiketi araçtan ayrılmalı.
      allow delete: if signedIn()
        && resource.data.ownerUid == request.auth.uid
        && resource.data.get('tagCode', null) == null;

      // Ziyaretçi bildirimleri: yalnızca sunucu oluşturur, sahibi okur.
      match /notices/{noticeId} {
        function ownsVehicle() {
          return signedIn()
            && get(/databases/$(database)/documents/vehicles/$(vehicleId)).data.ownerUid == request.auth.uid;
        }
        allow read, delete: if ownsVehicle();
        allow update: if ownsVehicle() && changedOnly(['read']) && request.resource.data.read is bool;
        allow create: if false;
      }
    }

    // ------------------------------------------------------------ Yönetici profili
    match /admin_profiles/{uid} {
      allow read: if isStaff();
      allow create, update: if isStaff() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['displayName', 'phone', 'photoDataUrl', 'updatedAt'])
        && request.resource.data.displayName is string && request.resource.data.displayName.size() <= 60
        && request.resource.data.phone is string && request.resource.data.phone.size() <= 20
        && (request.resource.data.photoDataUrl == null
            || (request.resource.data.photoDataUrl is string
                && request.resource.data.photoDataUrl.size() < 80000
                && request.resource.data.photoDataUrl.matches('data:image/jpeg;base64,[A-Za-z0-9+/=]+')));
      allow delete: if false;
    }

    // ------------------------------------------------------------ Yönetici oturumları
    // Her yönetici yalnızca kendi oturum kayıtlarını görür; kayıtlar silinmez,
    // yalnızca "kapatıldı" olarak işaretlenir (geri açılamaz).
    match /admin_sessions/{sessionId} {
      // Tek kayıt: resource == null, henüz oluşturulmamış kaydın varlık kontrolüne izin verir (içerik sızdırmaz).
      allow get: if isStaff() && (resource == null || resource.data.uid == request.auth.uid);
      // Liste sorgusu: yalnızca where('uid', '==', kendi uid) ile yapılabilir.
      allow list: if isStaff() && resource.data.uid == request.auth.uid;
      allow create: if isStaff()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['uid', 'email', 'device', 'userAgent', 'createdAt', 'lastActiveAt', 'expiresAt', 'revoked'])
        && request.resource.data.revoked == false
        && request.resource.data.device is string && request.resource.data.device.size() <= 60
        && request.resource.data.userAgent is string && request.resource.data.userAgent.size() <= 200
        && request.resource.data.createdAt is timestamp
        && request.resource.data.expiresAt is timestamp
        && request.resource.data.expiresAt <= request.resource.data.createdAt + duration.value(8, 'h');
      allow update: if isStaff()
        && resource.data.uid == request.auth.uid
        && changedOnly(['lastActiveAt', 'revoked', 'revokedAt'])
        && request.resource.data.revoked is bool
        && (resource.data.revoked == false || request.resource.data.revoked == true);
      allow delete: if false;
    }

    // ------------------------------------------------------------ Üretim partileri
    match /production_batches/{batchId} {
      allow read: if isStaff();
      // Oluşturma sunucuda; yöneticiler yalnızca yaşam döngüsü durumunu günceller.
      allow update: if isStaff()
        && changedOnly(['status', 'updatedBy', 'updatedAt', 'updatedAtFirestore']);
      allow create, delete: if false;
    }

    // ------------------------------------------------------------ Personel
    match /staff_members/{email} {
      allow read: if isStaff();
      allow write: if isSuperAdmin();
    }

    // ------------------------------------------------------------ Kullanıcı profili
    match /users/{userId} {
      allow read, write: if signedIn() && request.auth.uid == userId;

      // Bu kullanıcının cihazlarına ait web push jetonları
      match /push_tokens/{tokenId} {
        allow read, delete: if signedIn() && request.auth.uid == userId;
        allow create, update: if signedIn() && request.auth.uid == userId
          && request.resource.data.keys().hasOnly(['token', 'platform', 'userAgent', 'updatedAt'])
          && request.resource.data.token is string
          && request.resource.data.token.size() < 4096
          && request.resource.data.platform in ['ios', 'android', 'web']
          && request.resource.data.userAgent is string
          && request.resource.data.userAgent.size() <= 200;
      }

      // Bu kullanıcının cihazları (ana ekrana ekleme, bildirim izni). Yalnızca sunucu yazar.
      match /devices/{deviceId} {
        allow read: if signedIn() && request.auth.uid == userId;
        allow write: if false;
      }
    }

    // ------------------------------------------------------------ Şifreli kasa (sıfır bilgi)
    match /vaults/{userId} {
      allow read, write: if signedIn() && request.auth.uid == userId;
    }

    // ------------------------------------------------------------ SOS / Sosyal kart (rafta)
    // Herkese açık okuma kapatıldı; yalnızca kart sahibi okuyup yazabilir.
    match /cards/{cardId} {
      allow read: if signedIn() && resource.data.get('ownerUid', null) == request.auth.uid;
      allow create: if signedIn() && request.resource.data.get('ownerUid', null) == request.auth.uid;
      allow update: if signedIn()
        && resource.data.get('ownerUid', null) == request.auth.uid
        && request.resource.data.get('ownerUid', null) == request.auth.uid;
      allow delete: if signedIn() && resource.data.get('ownerUid', null) == request.auth.uid;
    }

    // ------------------------------------------------------------ Eski sistem (salt okunur)
    match /qr_registry/{tagId} {
      allow read: if isStaff();
      allow write: if false;
    }

    // ------------------------------------------------------------ Kampanya işaretleri (Genel Bakış grafiği)
    match /campaigns/{id} {
      allow read, delete: if isStaff();
      allow create: if isStaff()
        && request.resource.data.keys().hasOnly(['title', 'start', 'end', 'createdBy', 'createdAt'])
        && request.resource.data.title is string
        && request.resource.data.title.size() >= 1 && request.resource.data.title.size() <= 60
        && request.resource.data.start is string && request.resource.data.start.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}')
        && request.resource.data.end is string && request.resource.data.end.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}')
        && request.resource.data.start <= request.resource.data.end
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdAt == request.time;
      allow update: if false;
    }

    // ------------------------------------------------------------ Sunucuya özel
    match /tag_events/{id}   { allow read: if isStaff(); allow write: if false; }
    match /rate_limits/{id}  { allow read, write: if false; }
    match /counters/{id}     { allow read, write: if false; }
    // İstatistik sayaçları ve şüpheli okutma uyarıları yalnızca sunucuda okunur/yazılır.
    match /stats_daily/{id}  { allow read, write: if false; }
    match /stats_shards/{id} { allow read, write: if false; }
    match /stats_meta/{id}   { allow read, write: if false; }
    match /scan_alerts/{id}  { allow read, write: if false; }
    // Kalıcı silinmiş QR kodlarının kaydı (kod bir daha üretilmez, okutulursa "kapatılmış" görünür)
    match /tag_tombstones/{id} { allow read, write: if false; }
    // Yönetici paneli kullanıcı/araç dizini, silinmiş hesap kayıtları ve müşteri kaydı erişim günlüğü:
    // yalnızca sunucu okur/yazar. Yönetici bu verileri maskelenmiş halde Cloud Functions üzerinden görür
    // (telefon numarası hiçbir zaman açık gönderilmez).
    match /user_index/{id}       { allow read, write: if false; }
    match /vehicle_index/{id}    { allow read, write: if false; }
    match /deleted_accounts/{id} { allow read, write: if false; }
    match /admin_access_log/{id} { allow read, write: if false; }

    // Listelenmeyen her şey kapalı.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
