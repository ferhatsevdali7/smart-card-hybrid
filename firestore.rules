rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if request is from authenticated user
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Helper function to check if user is a registered staff member
    function isStaff() {
      return isAuthenticated() && (
        exists(/databases/$(database)/documents/staff_members/$(request.auth.token.email)) ||
        request.auth.token.email == 'sevdaliferhat64@gmail.com' ||
        request.auth.token.email == 'hasimturcan199@gmail.com'
      );
    }

    // Public cards collection (Individual card get allowed for public QR scan, mass listing strictly blocked)
    match /cards/{cardId} {
      allow get: if true;
      allow list: if false; // BLOCK MASS HARVESTING
      allow write: if isAuthenticated();
    }

    // User profiles
    match /users/{userId} {
      allow read, write: if isAuthenticated() && request.auth.uid == userId;
    }

    // Zero-knowledge encrypted vaults
    match /vaults/{userId} {
      allow read, write: if isAuthenticated() && request.auth.uid == userId;
    }

    // 🔒 STRICT SECURITY: Staff & Roles Collection (Only verified staff can read, only super admin can write)
    match /staff_members/{email} {
      allow read, write: if isStaff();
    }

    // 🔒 STRICT SECURITY: Physical QR Registry Bank
    // Individual tag lookup allowed for claiming/activation; mass registry listing allowed ONLY for staff
    match /qr_registry/{tagId} {
      allow get: if true;
      allow list: if isStaff(); // BLOCK MASS PIN & EMAIL HARVESTING
      allow write: if isStaff() || isAuthenticated();
    }

    // 🔒 STRICT SECURITY: Production Batches (Only staff can read and manage batches)
    match /production_batches/{batchId} {
      allow read, write: if isStaff();
    }
  }
}
