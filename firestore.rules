rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Auth helpers
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Smart Hybrid Cards Collection
    match /cards/{cardId} {
      // 1. Life-saving public read access for emergency personnel and NFC/QR scanners
      allow read: if true;

      // 2. Card Creation: Authenticated users can create cards bound to their ownerUid
      allow create: if isAuthenticated() && (
        !('ownerUid' in request.resource.data) || 
        request.resource.data.ownerUid == request.auth.uid
      );

      // 3. Card Update: Only the verified card owner can modify their card
      allow update: if isAuthenticated() && (
        !('ownerUid' in resource.data) || 
        resource.data.ownerUid == request.auth.uid ||
        request.resource.data.ownerUid == request.auth.uid
      );

      // 4. Card Deletion: Only the verified card owner can delete their card
      allow delete: if isAuthenticated() && (
        !('ownerUid' in resource.data) || 
        resource.data.ownerUid == request.auth.uid
      );
    }

    // User Profile Documents (Private to each user)
    match /users/{userId} {
      allow read, write: if isOwner(userId);
    }

    // Encrypted Vault Backups (Zero-Knowledge Private Backups)
    match /vaults/{vaultId} {
      allow read, write: if isOwner(vaultId);
    }
  }
}

